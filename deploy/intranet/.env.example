# Copy to .env and replace every REPLACE_ME value before starting.
# This file is intentionally safe to commit; deploy/intranet/.env is ignored.

COMPOSE_PROJECT_NAME=tdai-memory-intranet
INTRANET_BIND_ADDRESS=127.0.0.1
COMPOSE_NETWORK_INTERNAL=false

CORE_HOST_PORT=8420
PANEL_HOST_PORT=8125
KNOWLEDGE_HOST_PORT=8424
PROXY_HOST_PORT=8096
INTRANET_PUBLIC_HOST=127.0.0.1

# Layer 1: Core gateway Bearer. Layer 2: the admin/user_key is sent as
# x-tdai-user-key by Panel or as the client Bearer token by Proxy.
TDAI_GATEWAY_API_KEY=REPLACE_ME_WITH_openssl_rand_hex_32
TDAI_ADMIN_USER_KEY=REPLACE_ME_WITH_A_LONG_RANDOM_USER_KEY
TDAI_ADMIN_USERNAME=admin
TDAI_INSTANCE_ID=default

# Internal OpenAI-compatible endpoint. The base URL normally ends in /v1;
# it must not be a public Internet URL in an intranet deployment.
TDAI_LLM_BASE_URL=http://llm.internal.example/v1
TDAI_LLM_API_KEY=REPLACE_ME
TDAI_LLM_MODEL=REPLACE_ME
TDAI_LLM_MAX_TOKENS=4096
TDAI_LLM_TIMEOUT_MS=120000

# Proxy uses these names. Leave them equal to the Core endpoint/key unless
# proxy traffic should use a separate internal model gateway.
INTRANET_LLM_BASE_URL=http://llm.internal.example/v1
INTRANET_LLM_API_KEY=REPLACE_ME
INTRANET_LLM_MODEL=REPLACE_ME

# Knowledge defaults to the same endpoint. Override these if Wiki/CodeGraph
# should use a different internal model gateway.
KNOWLEDGE_LLM_MODE=custom
KNOWLEDGE_LLM_PROTOCOL=openai
KNOWLEDGE_LLM_BASE_URL=
KNOWLEDGE_LLM_API_KEY=
KNOWLEDGE_LLM_MODEL=
KNOWLEDGE_PUBLIC_BASE_URL=http://127.0.0.1:8424/v3

# The Panel displays this as the client-facing Proxy base URL.
TDAI_PROXY_PUBLIC_URL=http://127.0.0.1:8096

# Build-time mirrors. Set both to approved internal mirrors on an offline
# build host; runtime containers do not need npm/apt network access.
APT_MIRROR=deb.debian.org
NPM_REGISTRY=https://registry.npmjs.org
PANEL_UI=web
PANEL_WEB_UI=1

PANEL_LOG_LEVEL=info
PANEL_LOG_FORMAT=json
KNOWLEDGE_LOG_LEVEL=info
PROXY_MAX_OLD_SPACE_MB=1536
